include_guard(GLOBAL)
function(k210_set_linker_script target script)
    cmake_parse_arguments(PARSE_ARGV 2 ARG "" "" "DEPENDS")
    if(ARG_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "Unknown k210_set_linker_script arguments: ${ARG_UNPARSED_ARGUMENTS}")
    endif()
    get_filename_component(script "${script}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(NOT EXISTS "${script}")
        message(FATAL_ERROR "Linker script not found: ${script}")
    endif()
    set(dependencies "${script}")
    foreach(dependency IN LISTS ARG_DEPENDS)
        get_filename_component(dependency "${dependency}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND dependencies "${dependency}")
    endforeach()
    set_target_properties(${target} PROPERTIES K210_LINKER_SCRIPT "${script}"
        K210_LINKER_SCRIPT_DEPENDS "${dependencies}")
    get_target_property(configured ${target} K210_SCRIPT_CONFIGURED)
    if(NOT configured)
        target_link_libraries(${target} PRIVATE k210_linker_script)
        set_property(TARGET ${target} PROPERTY K210_SCRIPT_CONFIGURED TRUE)
    endif()
endfunction()
function(k210_add_extra_outputs target)
    get_target_property(configured ${target} K210_OUTPUTS_CONFIGURED)
    if(configured)
        return()
    endif()
    set_property(TARGET ${target} PROPERTY K210_OUTPUTS_CONFIGURED TRUE)
    target_link_options(${target} PRIVATE "LINKER:-Map=$<TARGET_FILE_DIR:${target}>/$<TARGET_FILE_BASE_NAME:${target}>.map")
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND "${CMAKE_OBJCOPY}" -O binary "$<TARGET_FILE:${target}>"
                "$<TARGET_FILE_DIR:${target}>/$<TARGET_FILE_BASE_NAME:${target}>.bin"
        VERBATIM)
endfunction()
