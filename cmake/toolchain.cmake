set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES K210_TOOLCHAIN_PATH TOOLCHAIN)
if(NOT K210_TOOLCHAIN_PATH AND DEFINED ENV{K210_TOOLCHAIN_PATH})
    set(K210_TOOLCHAIN_PATH "$ENV{K210_TOOLCHAIN_PATH}")
endif()
if(NOT K210_TOOLCHAIN_PATH)
    if(TOOLCHAIN)
        set(K210_TOOLCHAIN_PATH "${TOOLCHAIN}")
    elseif(DEFINED ENV{TOOLCHAIN})
        set(K210_TOOLCHAIN_PATH "$ENV{TOOLCHAIN}")
    endif()
endif()
if(K210_TOOLCHAIN_PATH)
    get_filename_component(K210_TOOLCHAIN_PATH "${K210_TOOLCHAIN_PATH}" ABSOLUTE)
    find_program(_k210_gcc riscv64-unknown-elf-gcc PATHS "${K210_TOOLCHAIN_PATH}" NO_DEFAULT_PATH NO_CACHE REQUIRED)
else()
    find_program(_k210_gcc riscv64-unknown-elf-gcc NO_CACHE REQUIRED)
    get_filename_component(K210_TOOLCHAIN_PATH "${_k210_gcc}" DIRECTORY)
endif()
set(K210_TOOLCHAIN_PATH "${K210_TOOLCHAIN_PATH}" CACHE PATH "RISC-V GCC bin directory" FORCE)
set(CMAKE_C_COMPILER "${_k210_gcc}")
foreach(_pair "CXX_COMPILER:g++" "ASM_COMPILER:gcc" "AR:gcc-ar" "RANLIB:gcc-ranlib"
              "LINKER:ld" "OBJCOPY:objcopy" "OBJDUMP:objdump" "SIZE:size" "NM:nm")
    string(REPLACE ":" ";" _parts "${_pair}")
    list(GET _parts 0 _cmake_name)
    list(GET _parts 1 _tool)
    unset(_k210_tool)
    find_program(_k210_tool "riscv64-unknown-elf-${_tool}" PATHS "${K210_TOOLCHAIN_PATH}" NO_DEFAULT_PATH NO_CACHE REQUIRED)
    set(CMAKE_${_cmake_name} "${_k210_tool}")
endforeach()
set(CMAKE_LINK_GROUP_USING_RESCAN "LINKER:--start-group" "LINKER:--end-group")
set(CMAKE_LINK_GROUP_USING_RESCAN_SUPPORTED TRUE)
