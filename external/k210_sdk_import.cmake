# Copy into a consumer and include BEFORE project().
include_guard(GLOBAL)
if(NOT K210_SDK_PATH AND DEFINED ENV{K210_SDK_PATH})
    set(K210_SDK_PATH "$ENV{K210_SDK_PATH}")
endif()
if(NOT K210_SDK_PATH AND DEFINED ENV{HOME})
    set(K210_SDK_PATH "$ENV{HOME}/k210-sdk")
endif()
get_filename_component(K210_SDK_PATH "${K210_SDK_PATH}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
if(NOT EXISTS "${K210_SDK_PATH}/k210_sdk_init.cmake")
    message(FATAL_ERROR "Set K210_SDK_PATH to a K210 SDK checkout containing k210_sdk_init.cmake")
endif()
set(K210_SDK_PATH "${K210_SDK_PATH}" CACHE PATH "K210 SDK checkout" FORCE)
include("${K210_SDK_PATH}/k210_sdk_init.cmake")
if(CMAKE_C_COMPILER_LOADED OR CMAKE_CXX_COMPILER_LOADED)
    message(FATAL_ERROR "Include k210_sdk_import.cmake before project()")
endif()
if(CMAKE_TOOLCHAIN_FILE AND NOT CMAKE_TOOLCHAIN_FILE STREQUAL "${K210_SDK_PATH}/cmake/toolchain.cmake")
    message(FATAL_ERROR "K210 SDK requires its toolchain; use K210_TOOLCHAIN_PATH to select the compiler")
endif()
set(CMAKE_TOOLCHAIN_FILE "${K210_SDK_PATH}/cmake/toolchain.cmake" CACHE FILEPATH "K210 toolchain")
