include_guard(GLOBAL)
cmake_minimum_required(VERSION 3.25)
set(K210_SDK_PATH "${CMAKE_CURRENT_LIST_DIR}" CACHE PATH "K210 SDK checkout" FORCE)
include("${CMAKE_CURRENT_LIST_DIR}/cmake/targets.cmake")
macro(k210_sdk_init)
    if(NOT TARGET k210_stdlib)
        add_subdirectory("${K210_SDK_PATH}/lib" "${CMAKE_BINARY_DIR}/k210-sdk" EXCLUDE_FROM_ALL)
    endif()
endmacro()
